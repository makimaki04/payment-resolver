API_KEY=local-development-key
POSTGRES_USER=payments
POSTGRES_DB=payments
POSTGRES_PASSWORD=payments-dev-password
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments-dev-password
DATABASE_URL=postgresql+asyncpg://payments:payments-dev-password@postgres:5432/payments
RABBITMQ_URL=amqp://payments:payments-dev-password@rabbitmq:5672/
WEBHOOK_ALLOWED_ORIGINS=["http://webhook:8081"]
RETRY_BASE_SECONDS=5
APP_ENV=development
LOG_LEVEL=INFO
# LOG_FORMAT is optional: text in development, json in production.
